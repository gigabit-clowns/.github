{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "pip-compile": {
    "managerFilePatterns": ["/^\\.github/requirements-lint\\.txt$/"]
  },
  "packageRules": [
    {
      "description": "Avoid internal call SHAs infinite update loop",
      "matchDepNames": ["gigabit-clowns/.github"],
      "enabled": false
    },
    {
      "description": "pip-compile owns the lock. pip_requirements claims it too by name, and would raise the pin while leaving the hash it no longer matches",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": [".github/requirements-lint.txt"],
      "enabled": false
    },
    {
      "description": "PyYAML, which yamllint needs, publishes no wheel past cp314, and the linters install with --only-binary. Lift this once it does",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Python packages pinned inside a run: block, which no manager reads",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.yml$/",
        "/^\\.github/composites/.+/action\\.yml$/"
      ],
      "matchStrings": [
        "(?<depName>[A-Za-z0-9._-]+)==(?<currentValue>[0-9][^\\s\\\\]*)"
      ],
      "datasourceTemplate": "pypi"
    }
  ]
}
